# ==============================================================================
# EV BATTERY MONITORING SYSTEM - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Application Configuration
APP_NAME="EV Battery Safety & Health Monitoring"
APP_VERSION="1.0.0"
DEBUG=false
API_PREFIX="/api"

# Database Configuration
# Default is local SQLite (Zero setup required)
DATABASE_URL="sqlite:///./ev_battery.db"
# For PostgreSQL (Docker or Host installation), uncomment:
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/ev_battery"

# MQTT Broker Configuration
MQTT_BROKER_HOST="localhost"
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID="ev-battery-backend-server"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_KEEPALIVE=60

# Telemetry Topics
MQTT_TELEMETRY_TOPIC="ev-battery/+/telemetry"
MQTT_STATUS_TOPIC="ev-battery/+/status"
MQTT_ALERTS_TOPIC="ev-battery/ev-battery-001/alerts"

# Connectivity Watchdog Thresholds (seconds)
STALE_DATA_THRESHOLD_SECONDS=6
DISCONNECTED_THRESHOLD_SECONDS=15

# Battery Pack Physical Characteristics
BATTERY_CHEMISTRY="LI_ION"       # LI_ION or LIFEPO4
SERIES_CELLS=3                   # 3S default (11.1V nominal, 12.6V max)
BATTERY_CAPACITY_AH=2.5          # Nominal capacity in Amp-hours
COULOMB_CHARGE_EFFICIENCY=0.98   # 98% charge coulombic efficiency
INITIAL_SOC_PERCENT=85.0

# Safety Thresholds
CELL_OVERVOLTAGE_WARNING_V=4.20
CELL_OVERVOLTAGE_CRITICAL_V=4.28
CELL_UNDERVOLTAGE_WARNING_V=3.10
CELL_UNDERVOLTAGE_CRITICAL_V=2.85
OVERCURRENT_CHARGE_LIMIT_A=5.0
OVERCURRENT_DISCHARGE_LIMIT_A=15.0
TEMP_OVERHEAT_WARNING_C=45.0
TEMP_OVERHEAT_CRITICAL_C=55.0

# AI Anomaly Detection
MODEL_DIR="app/ai/models"
ANOMALY_CONTAMINATION_RATE=0.05
